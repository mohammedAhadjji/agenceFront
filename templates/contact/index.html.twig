{% extends 'base.html.twig' %}

{% block title %}Hello ContactController!{% endblock %}

{% block body %}
 <div class="banner-slider" style="background-image: url({{ asset('assetes/imageApp/banner_service.jpg') }})">
	<div class="bg"></div>
	<div class="bannder-table">
		<div class="banner-text">
			<h1>contact</h1>
		</div>
	</div>
</div>
<div class="contact-area bg-area pt_50 pb_80">
    <div class="container wow fadeIn">
        <div class="row">
            <div class="col-md-7 mt_30 wow fadeIn" data-wow-delay="0.1s">
                <div class="contact-form">
                    <div class="headstyle">
                        <h4>Contact Form</h4>
                        {% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }}">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}
                    </div>
{{ form_start(form, {'attr': {'class': 'form-row'}}) }}

    <div class="form-group">
        {{ form_row(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Full Name'}}) }}
    </div>
    
    <div class="form-group">
        {{ form_row(form.phone, {'attr': {'class': 'form-control', 'placeholder': 'Phone Number'}}) }}
    </div>
    
    <div class="form-group">
        {{ form_row(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Email Address'}}) }}
    </div>
    
    <div class="form-group">
        {{ form_row(form.message, {'attr': {'class': 'form-control', 'placeholder': 'Message', 'style': 'height:195px;'}}) }}
    </div>
    
    <button type="submit" class="btn btn-primary" name="form_contact">Submit</button>

{{ form_end(form) }}
              </div>
            </div>
            <div class="col-md-5 mt_30 wow fadeIn" data-wow-delay="0.1s">
                <div class="headstyle">
                    <h4>Contact Information</h4>
                </div>
                <div class="row">
                    <div class="col-md-12 col-sm-12 wow fadeIn" data-wow-delay="0.2s">
                        <div class="contact-item mb_30">
                            <div class="contact-text">
                                <h3>Address</h3>
                                <p>
                                    3153 Foley Street<br />
Miami, FL 33176                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 col-sm-12 wow fadeIn" data-wow-delay="0.3s">
                        <div class="contact-item mb_30">
                            <div class="contact-text">
                                <h3>Email</h3>
                                <p>
                                    sales@yourwebsite.com<br />
support@yourwebsite.com                                </p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-12 col-sm-12 wow fadeIn" data-wow-delay="0.4s">
                        <div class="contact-item mb_30">
                            <div class="contact-text">
                                <h3>Phone</h3>
                                <p>
                                    Office 1: 954-648-1802<br />
Office 2: 963-612-1782                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 mt_50 wow fadeIn">
                <div class="map-area">
                    <div class="headstyle">
                        <h4>Map Location</h4>
                    </div>
                   <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3281.8966627296795!2d-1.9103156245440802!3d34.65731258554008!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd787ca7abf0facf%3A0x5ea075eea8038ba1!2sEHEI%20%3A%20%C3%89cole%20des%20Hautes%20%C3%89tudes%20d&#39;Ing%C3%A9nierie%20Oujda!5e0!3m2!1sfr!2sma!4v1713802961804!5m2!1sfr!2sma" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>                </div>
            </div>
        </div>
    </div>
</div>

<div class="newsletter-area pt_120 pb_120" style="background-image: url(https://demo.phpscriptpoint.com/travelfresh/public/uploads/newsletter.jpg)" id="newsletter">
<div class="newsletter-bg"></div>
    <div class="container wow fadeIn" style="visibility: visible; animation-name: fadeIn;">
    <div class="row">
            <div class="col-md-12">
                <div class="main-headline white">
                    <div class="headline">
                        <h2>Newsletter</h2>
                    </div>
                    <p>
                        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Aliquid fugit expedita, iure ullam cum vero ex sint aperiam maxime.                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 mt_30 wow fadeIn" data-wow-delay="0.2s" style="visibility: visible; animation-delay: 0.2s; animation-name: fadeIn;">
                <div class="newsletter-message">
                </div>
                <form action="https://demo.phpscriptpoint.com/travelfresh/newsletter/send" class="" method="post" accept-charset="utf-8">
                    <div class="newsletter-submit">
                        <input type="text" placeholder="Enter Your Email" name="email_subscribe">
                        <input type="submit" value="Submit" name="form_subscribe">
                    </div>
                </form>            </div>
        </div>
    </div>
</div>
{% endblock %}
