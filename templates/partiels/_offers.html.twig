{% for offre in offers %}
<div class="col-md-4 col-xs-6 clear-three wow fadeIn">
    <div class="portfolio-item mt_30">
        <div class="portfolio-bg"></div>
        {% if offre['image'] is defined and offre['image']|length > 0 %}
    <img src="http://localhost:8001/attchments/offers/{{ offre['image'][0]['name'] }}" alt="">
{% endif %}
        <div class="portfolio-text">
           {% if offre['image'] is defined and offre['image']|length > 0 %}
    <a href="http://localhost:8001/attchments/offers/{{ offre['image'][0]['name'] }}" class="magnific">
        <i class="fa fa-search-plus"></i>
    </a>
{% endif %}
        </div>
    </div>
    <div class="photo-title">
        <a href="{{ path('app_offre_view', { 'id': offre['id'] }) }}">
            {{ offre['Titre'] }}<br>
             {% if offre['prix'] is defined %}
            <span style="font-size: 22px;">{{ offre['prix'] }} / personne</span>
            {% endif %}
            <br>
         {% if offre.date_fin is defined %}
    {% if is_date_expired(offre.date_fin) %}
        <span style="color:#e05d5d;">(Date de réservation expirée)</span>
    {% else %}
        <span style="color:#77d477;">(Available for Booking)</span>
    {% endif %}

{% endif %}


        </a>
    </div>
</div>
{% endfor %}