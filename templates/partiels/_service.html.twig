{% for service in services %}
            
       
                            <div class="col-md-4 col-xs-6 clear-three wow fadeIn" data-wow-delay="0.1s">
    <div class="service-item mt_30" style="min-height: 265px;background-image: url('http://localhost:8001/attchments/services/{{ service['image'] }}')">
        <a href="{{ path('app_service_view', {'id': service.id}) }}">
            <img src="http://localhost:8001/attchments/services/{{ service.icon }}" alt="Icone du service" style="
    width: 30%;
    min-height: 60px;">
            <div class="ser-text">
                <h4>{{ service.name }}</h4>
                <p>{{ service.content[:120]|raw }}</p>

            </div>
        </a>
    </div>
</div> {% endfor %}