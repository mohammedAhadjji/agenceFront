 {% for member in teamMembers %}
                                                <div class="team-item wow fadeIn" data-wow-delay="0.1s">
                            <div class="team-photo">
                                <div class="team-bg"></div>
                              {% if member.image is defined %}
               
                  <img src="http://localhost:8001/attchments/members/{{ member.image }}" alt="{{ member.name }}" style="height: 260px !important;width: 380px !important">

            {% endif %}   <div class="team-social">
                                    <ul>
                                                                                    <li><a href="#" target="_blank"><i class="fa fa-facebook"></i></a></li>
                                                                                                                            <li><a href="#" target="_blank"><i class="fa fa-twitter"></i></a></li>
                                                                                                                            <li><a href="#" target="_blank"><i class="fa fa-linkedin"></i></a></li>
                                                                                                                            <li><a href="#" target="_blank"><i class="fa fa-youtube"></i></a></li>
                                                                                                                                                                                                    </ul>
                                </div>
                            </div>
                            <div class="team-text">
                                <a href="https://demo.phpscriptpoint.com/travelfresh/team-member/8">{{ member.name }} {{ member.lastName }}</a>
                                <p>{{ member.specialite }}</p>
                            </div>
                        </div>
                        
                            
                        {% endfor %}