                                            <div id="msg-container" style="width:100%;margin-top:20px;overflow:hidden;"></div>
                                        </div>
                                    </form>


                                    <form action="#" id="bank_form" class="" style="display:none;" method="post" accept-charset="utf-8">

                                        <input type="hidden" name="p_id" value="9">
                                        <input type="hidden" name="item_amount" value="400">
                                        <input type="hidden" name="total_person" value="1">


                                        <div style="clear:both;margin-bottom:10px;"></div>
                                        <div class="form-group">
                                            <label>Bank Details</label><br>
                                            Bank Name: CIH<br>
Account Number: 1222320234444<br>
Branch Name: oujda branch<br>
Country: MAROCCO                                        </div>
                                            
                                        <div style="clear:both;margin-bottom:10px;"></div>
                                        <div class="form-group">
                                            <label>Transaction Information <span>*</span></label>
                                            <textarea name="transaction_info" class="form-control" cols="30" rows="10" style="height:150px;"></textarea>
                                        </div>
                                        
                                        <div style="clear:both;margin-bottom:10px;"></div>
                                        <div class="form-group">
                                            <button type="submit" class="btn btn-success pull-left" name="form3">Pay Now</button>
                                        </div>
                                    </form>
<br><br>
                                </div>
                            </div>                            


                        </div>



                    </div>
                    

                </div>
            </div>
        </div>
    </div>
<br>

<div class="newsletter-area pt_120 pb_120" style="background-image: url(https://demo.phpscriptpoint.com/travelfresh/public/uploads/newsletter.jpg)" id="newsletter">
<div class="newsletter-bg"></div>
    <div class="container wow fadeIn" style="visibility: visible; animation-name: fadeIn;">
    <div class="row">
            <div class="col-md-12">
                <div class="main-headline white">
                    <div class="headline">
                        <h2>Newsletter</h2>
                    </div>
                    <p>
                        Lorem ipsum dolor sit amet, consectetur adipisicing elit. Aliquid fugit expedita, iure ullam cum vero ex sint aperiam maxime.                    </p>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12 mt_30 wow fadeIn" data-wow-delay="0.2s" style="visibility: visible; animation-delay: 0.2s; animation-name: fadeIn;">
                <div class="newsletter-message">
                </div>
                <form action="https://demo.phpscriptpoint.com/travelfresh/newsletter/send" class="" method="post" accept-charset="utf-8">
                    <div class="newsletter-submit">
                        <input type="text" placeholder="Enter Your Email" name="email_subscribe">
                        <input type="submit" value="Submit" name="form_subscribe">
                    </div>
                </form>            </div>
        </div>
    </div>
</div>
<script>
document.getElementById('stripe_form').addEventListener('submit', function(event) {
    // Prevent form submission
    event.preventDefault();

    // Get form values
    var cardNumber = document.querySelector('input[name="card_number"]').value;
    var cardCvv = document.querySelector('input[name="card_cvv"]').value;
    var cardMonth = document.querySelector('input[name="card_month"]').value;
    var cardYear = document.querySelector('input[name="card_year"]').value;

    // Clear previous error messages
    var msgContainer = document.getElementById('msg-container');
    msgContainer.innerHTML = '';

    // Validate form values
    var errors = [];
    if (cardNumber.trim() === '') {
        errors.push('Card Number is required.');
    } else if (!/^\d{14}$/.test(cardNumber)) {
        errors.push('Card Number must be a 14-digit number.');
    }

    if (cardCvv.trim() === '') {
        errors.push('Card CVV is required.');
    } else if (!/^\d{3}$/.test(cardCvv)) {
        errors.push('Card CVV must be a 3-digit number.');
    }

    if (cardMonth.trim() === '') {
        errors.push('Expiry Month is required.');
    } else if (!/^\d{1,2}$/.test(cardMonth) || parseInt(cardMonth) < 1 || parseInt(cardMonth) > 12) {
        errors.push('Expiry Month must be a valid month (1-12).');
    }

    if (cardYear.trim() === '') {
        errors.push('Expiry Year is required.');
    } else if (!/^\d{4}$/.test(cardYear) || parseInt(cardYear) < new Date().getFullYear()) {
        errors.push('Expiry Year must be a valid year and not in the past.');
    }

    // Check if the card is not expired
    var currentYear = new Date().getFullYear();
    var currentMonth = new Date().getMonth() + 1;
    if (parseInt(cardYear) === currentYear && parseInt(cardMonth) < currentMonth) {
        errors.push('The card expiration date cannot be in the past.');
    }

    // If there are errors, display them and stop form submission
    if (errors.length > 0) {
        errors.forEach(function(error) {
            var errorMsg = document.createElement('div');
            errorMsg.style.color = 'red';
            errorMsg.textContent = error;
            msgContainer.appendChild(errorMsg);
        });
    } else {
        // If no errors, submit the form
        event.target.submit();
    }
});
</script>
{% endblock %}
