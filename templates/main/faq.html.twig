<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.panel-collapse').forEach(function(panel) {
        panel.addEventListener('show.bs.collapse', function() {
            const targetId = panel.querySelector('.panel-body p').getAttribute('id');
            const paragraph = document.getElementById(targetId);
            const fullText = paragraph.getAttribute('data-full-text');

            if (paragraph && fullText) {
                paragraph.innerText = '';
                let charIndex = 0;

                const intervalId = setInterval(function() {
                    if (charIndex < fullText.length) {
                        paragraph.innerText += fullText[charIndex];
                        charIndex++;
                    } else {
                        clearInterval(intervalId);
                    }
                }, 50); // Ajustez la vitesse d'affichage ici (50 ms par caractère)
            }
        });
    });
});
</script>




